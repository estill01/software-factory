+    def test_future_insertion_preserves_earlier_safe_frontier(self) -> None:
+        self.write_tracker(
+            self.proposed,
+            [
+                ("Accepted 0", [], "completed"),
+                ("Accepted 1", [0], "completed"),
+                ("Current work", [1], "in-progress"),
+                ("Later work", [2], "not-started"),
+                ("Inserted future work", [3], "not-started"),
+            ],
+        )
+        self.install_program_control(
+            {"0": [0], "1": [1], "2": [2], "3": [3]},
+            affected=[4],
+            resume=2,
+        )
+        packet = program_revision.build_revision_packet(
+            previous_tracker=self.previous,
+            proposed_tracker=self.proposed,
+            target_tracker_path=self.previous,
+            metadata=self.metadata({"0": [0], "1": [1], "2": [2], "3": [3]}),
+        )
+        self.assertEqual([2], packet["safe_frontier_blocks"])
+        self.assertEqual([4], packet["affected_proposed_blocks"])
+        self.assertEqual(2, packet["resume_block"])
